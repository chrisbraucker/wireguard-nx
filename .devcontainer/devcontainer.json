{
    "name": "Switch Homebrew (libnx) Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "options": ["-t", "chrisbraucker/wireguard-nx-dev"]
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "streetsidesoftware.code-spell-checker",
                "ms-vscode.makefile-tools"
            ]
        }
    },
    "containerEnv": {
        "WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
    },
    "forwardPorts": [28771],
    "mounts":[
        {"source": "codex-data", "target": "/codex", "type": "volume"},
        {"source": "wg-nx-history", "target": "/history", "type": "volume"}
    ],
    "overrideCommand": true,
    "remoteEnv": {
        "PATH": "/opt/devkitpro/devkitA64/bin:${containerEnv:PATH}"
    },
    "initializeCommand": ".devcontainer/initialize.sh",
    "postStartCommand": ".devcontainer/postStart.sh",
    "remoteUser": "devcontainer"
}
