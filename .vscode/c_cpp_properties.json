{
  "env": {
    "defaultIncludePath": [
      "${workspaceFolder}/common/include/**"
    ],
    "overlayIncludePath": [
      "${workspaceFolder}/overlay/lib/libultrahand/libtesla/include/**",
      "${workspaceFolder}/overlay/lib/libultrahand/libultra/include/**",
      "${workspaceFolder}/overlay/lib/libultrahand/common/**"
    ],
    "sysmoduleIncludePath": [
      "${workspaceFolder}/sysmodule/lib/Atmosphere-libs/libstratosphere/include/**",
      "${workspaceFolder}/sysmodule/lib/Atmosphere-libs/libvapours/include/**",
      "${workspaceFolder}/sysmodule/src/**"
    ],
    "defaultDefines": [
      "APP_TITLE=\"\"",
      "VERSION=\"\"",
      "BUILD_ID=\"\""
    ],
    "atmosphereDefines": [
      "ATMOSPHERE",
      "ATMOSPHERE_IS_STRATOSPHERE",
      "ATMOSPHERE_BOARD_NINTENDO_NX",
      "ATMOSPHERE_OS_HORIZON",
      "ATMOSPHERE_ARCH_ARM64",
      "ATMOSPHERE_ARCH_ARM_V8A",
      "ATMOSPHERE_CPU_ARM_CORTEX_A57"
    ],

    "hacIncludePaths": [
      "${env:DEVKITPRO}/devkitA64/aarch64-none-elf/include/**",
      "${env:DEVKITPRO}/libnx/include/**",
      "${env:DEVKITPRO}/portlibs/switch/include/**"
    ],
    "hacDefines": ["__SWITCH__", "_GNU_SOURCE"],
    "hacCompilerArgs": [
      "-std=gnu++23",
      "-D_GNU_SOURCE",
      "-DATMOSPHERE",
      "-DATMOSPHERE_IS_STRATOSPHERE",
      "-DATMOSPHERE_BOARD_NINTENDO_NX",
      "-DATMOSPHERE_OS_HORIZON",
      "-DATMOSPHERE_ARCH_ARM64",
      "-DATMOSPHERE_ARCH_ARM_V8A",
      "-DATMOSPHERE_CPU_ARM_CORTEX_A57",
      "-D__SWITCH__",
      "-DWGNX_ENABLE_DEBUG_PROBE=1"
    ],
    "hacCompilerPath": "${env:DEVKITPRO}/devkitA64/bin/aarch64-none-elf-g++"
  },

  "configurations": [
    {
      "name": "Switch",
      "includePath": ["${env:defaultIncludePath}", "${env:overlayIncludePath}", "${env:sysmoduleIncludePath}", "${env:hacIncludePaths}"],
      "defines": ["${env:defaultDefines}", "${env:atmosphereDefines}", "${env:hacDefines}"],
      "compilerPath": "${env:hacCompilerPath}",
      "compilerArgs": ["${env:hacCompilerArgs}"],
      "cStandard": "c11",
      "cppStandard": "gnu++23",
      "intelliSenseMode": "linux-gcc-arm64"
    }
  ],
  "version": 4
}
