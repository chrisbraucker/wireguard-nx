{
  "individual_frame_limit": 8192,
  "thread_stack_bytes": 16384,
  "minimum_margin": 1024,
  "chains": [
    {
      "name": "resolver-activation-handshake-log",
      "frames": [
        {"label": "workqueue root", "match": "WorkqueueThreadMain(void*)"},
        {"label": "resolver callback", "match": "DaemonRuntime::ResolverWorkCallback("},
        {"label": "resolver operation", "match": "RuntimeEffectExecutor::RunEndpointResolver()"},
        {"label": "effect iteration", "match": "RuntimeEffectExecutor::Execute(const"},
        {"label": "UDP bind open", "match": "RuntimeEffectExecutor::ExecuteOpenUdpBind("},
        {"label": "coordinator dispatch", "match": "EffectBatch wgnx::sysmodule::runtime::RuntimeCoordinator::Dispatch("},
        {"label": "peer dispatch", "match": "EffectBatch wgnx::sysmodule::runtime::PeerRuntime::Handle("},
        {"label": "bind completion event", "match": "[with auto:60 = wgnx::sysmodule::runtime::UdpBindOpenedEvent]"},
        {"label": "handshake startup", "match": "PeerRuntime::StartHandshake("},
        {"label": "initiation staging", "match": "PeerRuntime::PrepareHandshakeInitiation("},
        {"label": "initiation creation", "match": "noise_handshake_create_initiation("},
        {"label": "transition logging", "match": "logger.cpp:136:6:"}
      ]
    },
    {
      "name": "receive-commit-transport-log",
      "frames": [
        {"label": "workqueue root", "match": "WorkqueueThreadMain(void*)"},
        {"label": "receive callback", "match": "DaemonRuntime::ReceiveWorkCallback("},
        {"label": "receive pump", "match": "EncryptedReceivePump::Run("},
        {"label": "receive commit", "match": "EncryptedReceivePump::CommitReceivedPacket("},
        {"label": "coordinator dispatch", "match": "EffectBatch wgnx::sysmodule::runtime::RuntimeCoordinator::Dispatch("},
        {"label": "peer dispatch", "match": "EffectBatch wgnx::sysmodule::runtime::PeerRuntime::Handle("},
        {"label": "encrypted admission", "match": "PeerRuntime::HandleEncryptedDatagram("},
        {"label": "transport handling", "match": "PeerRuntime::HandleTransportData("},
        {"label": "session establishment", "match": "noise_handshake_begin_session("},
        {"label": "transition logging", "match": "logger.cpp:136:6:"}
      ]
    },
    {
      "name": "receive-generated-send-log",
      "frames": [
        {"label": "workqueue root", "match": "WorkqueueThreadMain(void*)"},
        {"label": "receive callback", "match": "DaemonRuntime::ReceiveWorkCallback("},
        {"label": "receive pump", "match": "EncryptedReceivePump::Run("},
        {"label": "effect iteration", "match": "RuntimeEffectExecutor::Execute(const"},
        {"label": "UDP datagram send", "match": "RuntimeEffectExecutor::ExecutePendingDatagramSend("},
        {"label": "send logging", "match": "logger.cpp:136:6:"}
      ]
    },
    {
      "name": "receive-failure-publication",
      "frames": [
        {"label": "workqueue root", "match": "WorkqueueThreadMain(void*)"},
        {"label": "receive callback", "match": "DaemonRuntime::ReceiveWorkCallback("},
        {"label": "receive pump", "match": "EncryptedReceivePump::Run("},
        {"label": "failure commit", "match": "EncryptedReceivePump::CommitReceiveFailure("},
        {"label": "effect iteration", "match": "RuntimeEffectExecutor::Execute(const"},
        {"label": "failure logging", "match": "logger.cpp:136:6:"}
      ]
    }
  ]
}
